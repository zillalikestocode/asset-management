---
const APP_URL = 'http://localhost:5173'
// Replace with your Cal.com / Calendly link.
const BOOK_CALL_URL = 'https://cal.com/your-handle'

const links = [
  { label: 'Features',    href: '#features' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Sign in',     href: `${APP_URL}/login` },
  { label: 'Book a call', href: BOOK_CALL_URL },
]
---

<footer class="border-t border-white/10 bg-af-ink-900">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      {/* Brand */}
      <div class="flex items-center gap-3">
        <img src="/logo-mark.svg" alt="AssetFlow" class="h-6 w-6" />
        <span class="text-[13px] font-semibold tracking-tight text-white">AssetFlow</span>
        <span class="ml-1 font-mono text-[10px] text-af-ink-600">
          © {new Date().getFullYear()}
        </span>
      </div>

      {/* Nav */}
      <nav class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map(({ label, href }) => (
          <a
            href={href}
            class="text-[12px] text-af-ink-500 transition-colors duration-[120ms] hover:text-af-ink-300"
          >
            {label}
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-y-2 border-t border-white/5 pt-6">
      <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-af-ink-600">
        Asset registry · Work orders · Maintenance · QR scanning · Reports
      </p>
      <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-af-ink-600">
        Built for manufacturing SMEs
      </p>
    </div>
  </div>
</footer>
