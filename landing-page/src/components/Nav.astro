---
const links = [
  { label: 'Features',     href: '#features' },
  { label: 'How it works', href: '#how-it-works' },
]

const APP_URL = 'https://assetflow-app.netlify.app'
// Replace with your Cal.com / Calendly link.
const BOOK_CALL_URL = 'https://cal.com/your-handle'
---

<header class="sticky top-0 z-50 border-b border-af-border bg-af-surface/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-8 px-6">
    <a href="/" class="mr-auto flex items-center gap-2.5">
      <img src="/logo-mark.svg" alt="AssetFlow" class="h-7 w-7" />
      <span class="text-[15px] font-semibold tracking-[-0.01em] text-af-fg">AssetFlow</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {links.map(({ label, href }) => (
        <a
          href={href}
          class="text-[13px] text-af-muted transition-colors duration-[120ms] hover:text-af-fg"
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`${APP_URL}/login`}
        class="hidden text-[13px] text-af-muted transition-colors duration-[120ms] hover:text-af-fg sm:block"
      >
        Sign in
      </a>
      <a
        href={BOOK_CALL_URL}
        target="_blank"
        rel="noopener"
        class="flex h-8 items-center gap-1.5 rounded-[5px] bg-af-orange-500 px-4 text-[13px] font-medium text-white transition-colors duration-[120ms] hover:bg-af-orange-600"
      >
        Book a call
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
    </div>
  </div>
</header>
